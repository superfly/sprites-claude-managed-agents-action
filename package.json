{
  "name": "sprites-claude-managed-agents-action",
  "version": "0.1.0",
  "private": true,
  "description": "Runs a Claude Managed Agents session in a Sprite",
  "license": "Apache-2.0",
  "author": "Fly.io",
  "type": "module",
  "scripts": {
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --type-aware --deny-warnings",
    "typecheck": "tsc",
    "test": "vitest run",
    "package": "rm -rf dist && rolldown --config rolldown.config.ts",
    "all": "npm run format && npm run lint && npm run typecheck && npm test && npm run package"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@anthropic-ai/sdk": "^0.133.0",
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/s3-request-presigner": "^3.1149.0",
    "@fly/sprites": "^0.2.3"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2004",
    "rolldown": "^1.2.13",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
